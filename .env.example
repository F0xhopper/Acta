GOOGLE_PLACES_API_KEY=
GOOGLE_PSI_API_KEY=
COMPANIES_HOUSE_API_KEY=
PLACES_MAX_REQUESTS_PER_RUN=30

# Build stage (optional until you deploy previews)
GITHUB_OWNER=F0xhopper
VERCEL_TOKEN=                 # optional: the pipeline uses `vercel login` on this machine when empty
VERCEL_TEAM_ID=               # optional: team id (team_...) or slug; found automatically when you have one team
PREVIEW_DOMAIN=               # optional: e.g. preview.acta.agency with *.preview CNAME to cname.vercel-dns.com
BUILD_MAX_TURNS=400
BUILD_MAX_MINUTES=240
# Optional. Headless builds use your Claude subscription by default and a full build can use most of a session's
# allowance. Set an Anthropic API key here to bill builds to the API instead (roughly $5-15 per site).
ACTA_AGENT_API_KEY=
# Stop a headless build when the Claude subscription's session or weekly usage reaches this percentage
ACTA_USAGE_STOP_PERCENT=70
