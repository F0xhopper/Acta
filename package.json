{
  "name": "acta",
  "version": "0.1.0",
  "description": "Find local businesses that need a website, audit them, score them, shortlist them.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ui": "tsx src/cli.ts ui",
    "ui:dev": "concurrently -k -n server,app \"tsx watch src/cli.ts ui\" \"pnpm --dir ui dev\"",
    "ui:build": "pnpm --dir ui build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.3",
    "hono": "^4.13.13",
    "imapflow": "^2.2.10",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.16",
    "p-limit": "^7.3.3",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
